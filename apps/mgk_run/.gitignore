# ─── Secrets & local config ──────────────────────────────────────────────
# Never commit real keys. See config/app_config.example.json for the shape.
.env
.env.*
/config/app_config.json
*.pem
secrets/
**/service-account*.json

# ─── Flutter / Dart ──────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
doc/api/
*.g.dart.lock
# Generated code from build_runner (Drift, json_serializable) is regenerated
# locally; keep it out of source control.
*.g.dart
*.freezed.dart
*.mocks.dart

# ─── iOS / Xcode ─────────────────────────────────────────────────────────
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/ephemeral/
ios/Runner/GeneratedPluginRegistrant.*
ios/**/*.mode1v3
ios/**/*.mode2v3
ios/**/*.pbxuser
ios/**/*.perspectivev3
ios/**/xcuserdata/
**/DerivedData/
*.xcworkspace/xcuserdata/
# App Store / signing
*.mobileprovision
*.p12
*.p8
ios/Runner/Info-secrets.plist

# ─── Supabase ────────────────────────────────────────────────────────────
supabase/.temp/
supabase/.branches/
.supabase/

# ─── IDE / OS ────────────────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db

# ─── Local dev tooling ───────────────────────────────────────────────────
# Claude Code settings hold personal permission grants — keep them out of the
# public repo.
.claude/
# Web is a local dev/preview target only; the app ships iOS-only (ADR-0001).
# Regenerate with: flutter create . --platforms web
/web/
# Preview-harness screenshots and Playwright MCP output are local UI-verification
# artifacts — never committed.
.playwright-mcp/
/screenshots/
/runio-*.png

# Supabase CLI scratch, written wherever the CLI happens to be invoked from.
**/supabase/.temp/

# Design plates: the PNGs written by test/plates, regenerated on demand.
# Anchored, so it ignores the output directory and not the source one.
/plates/
