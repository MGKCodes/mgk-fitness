# Normalize line endings: store and check out LF everywhere, so the repo is
# identical across macOS, Linux, and Windows (and CI on Ubuntu).
* text=auto eol=lf

# Binary assets — never normalize these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.p12   binary
*.p8    binary
*.mobileprovision binary
