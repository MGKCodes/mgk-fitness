<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Run</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>run</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Record your run's route, distance, and pace.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Keep recording your run in the background so tracking continues with the screen locked.</string>
	<!-- Required the moment the binary links HealthKit: App Store Connect
	     rejects an upload that references the framework without a purpose
	     string, so this is a build blocker rather than a nicety.

	     Both purpose strings are required, and the trigger is the ENTITLEMENT
	     rather than the code. App Store Connect rejected an upload with error
	     90683 for a missing update string while nothing wrote to Health at all:
	     "the app has one or more entitlements that permit such access... While
	     your app might not use these APIs, a purpose string is still required."
	     com.apple.developer.healthkit permits both directions; which one the app
	     performs is settled at request time, and Apple does not look. -->
	<!-- Every upload otherwise lands in App Store Connect as "Missing
	     Compliance" and cannot go to a tester until somebody answers the export
	     questionnaire by hand, per build.

	     False is the accurate answer, not the convenient one: the only
	     cryptography here is HTTPS to Supabase and to the coach function, which
	     is exempt under the standard TLS exemption. If the app ever ships crypto of
	     its own, this key has to be revisited rather than left. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHealthShareUsageDescription</key>
	<string>Read your workouts and step count from Health, so runs you recorded on a watch or another app appear in your training log and your coach sees the whole picture.</string>
	<!-- NSHealthUpdateUsageDescription IS REQUIRED, and removing it fails the
	     UPLOAD, not the review. 6f71c3c took it out on the reasoning that
	     health_read_types.dart requests HealthDataAccess.READ for WORKOUT and
	     STEPS and nothing else, and that HealthDataAccess appears nowhere else
	     in lib/. All of that is true about our Dart and none of it is what
	     Apple checks. App Store Connect refused the upload of 1.0.0+21 with
	     error 90683, in terms that answer the argument directly:

	       "If you're using external libraries or SDKs, they may reference APIs
	        that require a purpose string. While your app might not use these
	        APIs, a purpose string is still required."

	     health 13.2.0 links HKHealthStore's write methods and
	     com.apple.developer.healthkit is in Runner.entitlements, so the static
	     scan sees write access whatever our code asks for. The string below is
	     never shown to anybody: the prompt only appears when an app requests
	     write authorisation, and this one never does.

	     That also disposes of the Guideline 5.1.1 worry that motivated the
	     removal - a purpose string is not a request. This key can go when the
	     health dependency or the entitlement goes, and not before.

	     DO NOT REMOVE without running a real release build. No test in this
	     repo can catch it; 1,501 of them passed on the commit that broke it. -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Save the runs you record here into Health, so your training sits alongside everything else your phone keeps.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
