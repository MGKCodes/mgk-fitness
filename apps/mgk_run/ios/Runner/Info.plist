<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Runio</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>runio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Runio uses your location to record your run's route, distance, and pace.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Runio keeps recording your run in the background so tracking continues with the screen locked.</string>
	<!-- Required the moment the binary links HealthKit: App Store Connect
	     rejects an upload that references the framework without a purpose
	     string, so this is a build blocker rather than a nicety.

	     Both purpose strings are required, and the trigger is the ENTITLEMENT
	     rather than the code. App Store Connect rejected an upload with error
	     90683 for a missing update string while nothing wrote to Health at all:
	     "the app has one or more entitlements that permit such access... While
	     your app might not use these APIs, a purpose string is still required."
	     com.apple.developer.healthkit permits both directions; which one the app
	     performs is settled at request time, and Apple does not look. -->
	<!-- Every upload otherwise lands in App Store Connect as "Missing
	     Compliance" and cannot go to a tester until somebody answers the export
	     questionnaire by hand, per build.

	     False is the accurate answer, not the convenient one: the only
	     cryptography here is HTTPS to Supabase and to the coach function, which
	     is exempt under the standard TLS exemption. If Runio ever ships crypto of
	     its own, this key has to be revisited rather than left. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHealthShareUsageDescription</key>
	<string>Runio reads your workouts from Health so runs you recorded on a watch or another app appear in your training log, and so your coach sees the whole picture.</string>
	<!-- Runio does not write to Health yet. This describes what the entitlement
	     permits and what the app is built toward: workout_dedup.dart already
	     treats Runio's own recordings as the preferred source of a run, which
	     only means anything once they are there. -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Runio can save the runs you record here into Health, so your training sits alongside everything else your phone keeps.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
