			<array>
				<string>com.googleusercontent.apps.365688330886-ql9t29qtqbq15ove1nv3b0irh5dhr7vu</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Take progress photos to track your training over time.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Import existing progress photos to include in your training timelapse.</string>
