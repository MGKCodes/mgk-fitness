<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Lift is dark only, in either system mode: charcoal from the first
         frame the system draws to the first one Flutter does. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12 and later draw their own splash from these. -->
        <item name="android:windowSplashScreenBackground">@color/charcoal</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/charcoal</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/charcoal</item>
    </style>
</resources>
