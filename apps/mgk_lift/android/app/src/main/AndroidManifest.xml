<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- **The release build had no network access until 2026-09-02.**

         Flutter's template declares INTERNET in debug/AndroidManifest.xml and
         profile/AndroidManifest.xml only, and manifests are merged per build
         type — so `flutter run` works, a profile build works, and the release
         build that goes to Play cannot make a single request. Sign-in, sync, the
         coach, plan generation and photo upload all fail, and every one of them
         fails at runtime on a user's phone rather than at build time here.

         It was found by reading the merged release manifest rather than by a
         failure, because no release Android build had ever been run — Phase 4's
         "installed on a real Android device" is still open. Do not delete this
         line to tidy the file up; it is not inherited from anywhere. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- The rest-over alert, fired by the system with the phone locked.
         POST_NOTIFICATIONS and VIBRATE come from flutter_local_notifications'
         own manifest; this one is ours to claim.

         SCHEDULE_EXACT_ALARM, not USE_EXACT_ALARM. Android 12 and 13 grant it
         at install and a rest ends on the second; 14 and later deny it by
         default, and the alert falls back to an inexact one that can land a
         little late. USE_EXACT_ALARM would avoid that and is reserved by Play
         for alarm-clock and calendar apps, which this is not. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <application
        android:label="Lift"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The way back from Apple's sign-in, which on Android runs in
                 the browser: Supabase sends it to com.mgkcodes.liftio://login-callback,
                 which is on its redirect list, and supabase_flutter picks the
                 session up from the link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.mgkcodes.liftio" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Shows a scheduled notification when its alarm fires — without it
             the rest-over alert is scheduled and never appears. No boot
             receiver: a rest does not survive a reboot, and should not. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
